{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "exchanges": [
    {
      "name": "baixou",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "baixou.retry",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "baixou.dlx",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "scraper.requests",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "scraper.requests.retry",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "baixou",
        "x-dead-letter-routing-key": "scrape.requested",
        "x-message-ttl": 30000
      }
    },
    {
      "name": "scraper.requests.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "core.scrape.results",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "baixou",
      "vhost": "/",
      "destination": "scraper.requests",
      "destination_type": "queue",
      "routing_key": "scrape.requested",
      "arguments": {}
    },
    {
      "source": "baixou.retry",
      "vhost": "/",
      "destination": "scraper.requests.retry",
      "destination_type": "queue",
      "routing_key": "scrape.requested",
      "arguments": {}
    },
    {
      "source": "baixou.dlx",
      "vhost": "/",
      "destination": "scraper.requests.dlq",
      "destination_type": "queue",
      "routing_key": "scrape.dead",
      "arguments": {}
    },
    {
      "source": "baixou",
      "vhost": "/",
      "destination": "core.scrape.results",
      "destination_type": "queue",
      "routing_key": "scrape.completed",
      "arguments": {}
    },
    {
      "source": "baixou",
      "vhost": "/",
      "destination": "core.scrape.results",
      "destination_type": "queue",
      "routing_key": "scrape.failed",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "name": "scraper-requests-dead-letter",
      "vhost": "/",
      "pattern": "^scraper\\.requests$",
      "apply-to": "queues",
      "definition": {
        "dead-letter-exchange": "baixou.dlx",
        "dead-letter-routing-key": "scrape.dead"
      },
      "priority": 0
    }
  ]
}
